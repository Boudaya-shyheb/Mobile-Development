rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['fullName', 'phone', 'email', 'role', 'createdAt'])
        && request.resource.data.keys().hasAll(['fullName', 'phone', 'email', 'role', 'createdAt'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['passenger', 'driver']
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }
  }
}
